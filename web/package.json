{
  "name": "simpledocs-web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:worker": "esbuild worker/index.mjs --bundle --format=esm --platform=browser --target=es2022 --outfile=build/worker/index.js",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "verify": "pnpm check && pnpm build && pnpm build:worker && pnpm test && node --test worker/*.test.mjs"
  },
  "dependencies": {
    "@starwind-ui/astro": "1.5.0",
    "@tabler/icons": "^3.52.0",
    "@tailwindcss/forms": "^0.5",
    "@tailwindcss/vite": "^4",
    "astro": "^7.4.12",
    "jose": "^6.2.17",
    "tailwind-merge": "^3",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "miniflare": "4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "miniflare>undici": "7.30.2"
    }
  },
  "description": "Static Astro and Starwind UI front end for simpledocs. No backend is connected."
}
