---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import EmptyState from "@/components/EmptyState.astro";
---
<AppLayout title="Records" description="Communication records.">
  <PageHeader title="Records" summary="Communication records and documents." />
  <section class="mt-10 max-w-2xl">
    <EmptyState title="Record listing is not available yet">
      To check the last fax submitted in this browser session, open <a href="/fax/" class="underline underline-offset-4">Send a fax</a> and select Check delivery status. This page does not currently list saved records.
    </EmptyState>
  </section>
</AppLayout>
