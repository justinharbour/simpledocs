---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import NotConnectedNotice from "@/components/NotConnectedNotice.astro";
import EmptyState from "@/components/EmptyState.astro";
import DeliveryStateMark from "@/components/DeliveryStateMark.astro";
import SyntheticLabel from "@/components/SyntheticLabel.astro";
import Field from "@/components/Field.astro";
import UnavailableReason from "@/components/UnavailableReason.astro";
import { Input } from "@/components/starwind/input";
import {
  Table,
  TableBody,
  TableCaption,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/starwind/table";
import { deliveryStates, deliveryStateLabels, deliveryStateMeanings } from "@/lib/delivery";
import { exampleDeliveries } from "@/lib/examples";
---

<AppLayout title="Records" description="Documents, proofs and delivery records, searchable in one place.">
  <PageHeader title="Records" summary="Documents, proofs and delivery records, searchable in one place." />
  <NotConnectedNotice title="Storage is not connected">
    Documents and proofs are not stored yet. Do not upload real documents to this build.
  </NotConnectedNotice>

  <section aria-labelledby="list-heading" class="mt-10">
    <h2 id="list-heading" class="mb-3 text-lg font-semibold">All records</h2>
    <div class="mb-4 flex max-w-sm flex-col gap-2">
      <Field id="records-search" label="Search records">
        <Input id="records-search" type="search" disabled aria-describedby="search-reason" />
      </Field>
      <UnavailableReason id="search-reason">There are no records to search.</UnavailableReason>
    </div>
    <EmptyState title="No records yet">
      Documents, proofs and delivery records will appear here once something has been sent or received.
    </EmptyState>
  </section>

  <section aria-labelledby="examples-heading" class="mt-10">
    <div class="mb-1 flex flex-wrap items-center gap-2">
      <h2 id="examples-heading" class="text-lg font-semibold">How a delivery could read</h2>
      <SyntheticLabel />
    </div>
    <p class="text-muted-foreground mb-3 max-w-prose text-sm text-pretty">
      These four rows are synthetic examples of how proposed statuses could be shown. They are not records, and nothing was sent. Proposed: a job with two channels would have two deliveries, so one could succeed while the other fails.
    </p>
    <Table>
      <TableCaption class="sr-only">Example deliveries, not real records</TableCaption>
      <TableHeader>
        <TableRow>
          <TableHead scope="col">Job</TableHead>
          <TableHead scope="col">Channel</TableHead>
          <TableHead scope="col">Status</TableHead>
          <TableHead scope="col" class="hidden md:table-cell">What it means</TableHead>
        </TableRow>
      </TableHeader>
      <TableBody>
        {
          exampleDeliveries.map((row) => (
            <TableRow>
              <TableCell class="font-medium whitespace-normal">
                <span class="flex flex-wrap items-center gap-2">
                  {row.job}
                  <SyntheticLabel />
                </span>
                <span class="text-muted-foreground mt-1 block text-sm font-normal text-pretty md:hidden">{row.note}</span>
              </TableCell>
              <TableCell>{row.channel}</TableCell>
              <TableCell><DeliveryStateMark state={row.state} /></TableCell>
              <TableCell class="text-muted-foreground hidden whitespace-normal md:table-cell">{row.note}</TableCell>
            </TableRow>
          ))
        }
      </TableBody>
    </Table>
  </section>

  <section aria-labelledby="glossary-heading" class="mt-10">
    <h2 id="glossary-heading" class="mb-1 text-lg font-semibold">Status glossary</h2>
    <p class="text-muted-foreground mb-3 max-w-prose text-sm text-pretty">
      Proposed delivery statuses and what each would mean. None is implemented. Not every channel would use every one, and the status a provider reported would be kept separately from these.
    </p>
    <dl class="grid max-w-3xl gap-x-6 gap-y-3 text-sm sm:grid-cols-[12rem_1fr]">
      {
        deliveryStates.map((state) => (
          <>
            <dt class="font-medium">{deliveryStateLabels[state]}</dt>
            <dd class="text-muted-foreground text-pretty">{deliveryStateMeanings[state]}</dd>
          </>
        ))
      }
    </dl>
  </section>
</AppLayout>
