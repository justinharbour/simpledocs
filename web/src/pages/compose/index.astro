---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import NotConnectedNotice from "@/components/NotConnectedNotice.astro";
import Field from "@/components/Field.astro";
import UnavailableButton from "@/components/UnavailableButton.astro";
import UnavailableReason from "@/components/UnavailableReason.astro";
import { Checkbox } from "@/components/starwind/checkbox";
import { Input } from "@/components/starwind/input";
import { Textarea } from "@/components/starwind/textarea";
import { exampleJob } from "@/lib/examples";

const channels = [
  { id: "channel-fax", label: "Fax" },
  { id: "channel-mail", label: "Paper mail" },
];
---

<AppLayout
  title="Compose"
  description="Preview of how a fax and a paper letter are proposed to be prepared, approved and sent. Nothing can be sent yet."
>
  <PageHeader
    title="Compose"
    summary="Prepare one document for fax, paper mail or both. Proposed: each would be delivered, approved and tracked on its own."
  />

  <NotConnectedNotice title="Sending is unavailable">
    The mail draft editor below requires connected storage. The remaining controls are synthetic previews; nothing can be sent or uploaded.
  </NotConnectedNotice>

  <section class="mt-10 flex max-w-xl flex-col gap-4" aria-labelledby="draft-heading">
    <h2 id="draft-heading" class="text-lg font-semibold">Mail draft</h2>
    <p id="draft-hint" class="text-muted-foreground text-sm">Save text and an address only. Documents and sending are not available. Keep the draft link to open it again.</p>
    <form id="draft-form" class="flex flex-col gap-4">
      <fieldset id="draft-fields" disabled aria-describedby="draft-hint" class="flex flex-col gap-4 border-0 p-0">
      <legend class="sr-only">Mail draft fields</legend>
      <Field id="draft-recipient" label="Recipient"><Input id="draft-recipient" name="recipient" maxlength="500" /></Field>
      <Field id="draft-address" label="Mailing address"><Textarea id="draft-address" name="address" rows={3} maxlength="2000" /></Field>
      <Field id="draft-body" label="Letter text"><Textarea id="draft-body" name="body" rows={8} maxlength="20000" /></Field>
      <button type="submit" class="self-start rounded-md bg-primary px-4 py-2 text-primary-foreground">Save draft</button>
      </fieldset>
    </form>
    <p id="draft-status" role="status" aria-live="polite">Draft not saved.</p>
  </section>

  <div class="mt-10 flex max-w-xl flex-col gap-10">
    <section aria-labelledby="document-heading" class="flex flex-col gap-4">
      <h2 id="document-heading" class="text-lg font-semibold">Document</h2>
      <fieldset disabled class="flex flex-col gap-4 border-0 p-0" aria-describedby="document-hint">
        <legend class="sr-only">Document (unavailable)</legend>
        <Field id="document" label="File to send" hint="PDF. Proposed: once storage is connected, the file would be kept privately, with no public link.">
          <Input id="document" type="file" disabled aria-describedby="document-hint" />
        </Field>
      </fieldset>
    </section>

    <section aria-labelledby="channels-heading" class="flex flex-col gap-4">
      <h2 id="channels-heading" class="text-lg font-semibold">Channels</h2>
      <p id="channels-desc" class="text-muted-foreground max-w-prose text-sm text-pretty">
        Pick one or both. Proposed: each would create its own delivery with its own status, and a failure in one would not cause the other to be sent again.
      </p>
      <fieldset disabled class="flex flex-col gap-4 border-0 p-0" aria-describedby="channels-desc">
        <legend class="sr-only">Channels (unavailable)</legend>
        {
          channels.map((channel) => (
            <div class="flex items-center gap-2">
              <Checkbox id={channel.id} disabled aria-disabled="true" aria-labelledby={`${channel.id}-label`} />
              <span id={`${channel.id}-label`} class="font-medium">{channel.label}</span>
            </div>
          ))
        }
      </fieldset>
    </section>

    <section aria-labelledby="recipient-heading" class="flex flex-col gap-4">
      <h2 id="recipient-heading" class="text-lg font-semibold">Recipient</h2>
      <p id="recipient-desc" class="text-muted-foreground max-w-prose text-sm text-pretty">
        Every value here is a synthetic example. Proposed: changing the recipient or the document later would create a new revision and cancel any approval.
      </p>
      <fieldset disabled class="flex flex-col gap-4 border-0 p-0" aria-describedby="recipient-desc">
        <legend class="sr-only">Recipient (unavailable)</legend>
        <Field id="fax-number" label="Fax number" synthetic>
          <Input id="fax-number" type="tel" disabled value={exampleJob.fax.number} />
        </Field>
        <Field id="mail-name" label="Name for paper mail" synthetic>
          <Input id="mail-name" type="text" disabled value={exampleJob.mail.recipient} />
        </Field>
        <Field id="mail-address" label="Mailing address" synthetic>
          <Textarea id="mail-address" rows={3} disabled value={exampleJob.mail.address.join("\n")} />
        </Field>
      </fieldset>
    </section>

    <section aria-labelledby="proof-heading" class="flex flex-col gap-4">
      <h2 id="proof-heading" class="text-lg font-semibold">Proof and approval</h2>
      <p class="text-muted-foreground max-w-prose text-sm text-pretty">
        Proposed: paper mail would never be ordered from a preview drawn by this app. The mail provider would produce a proof of the exact letter, and you would approve that proof before anything is ordered. A proof shows what was approved, not that the letter arrived.
      </p>
      <div class="flex flex-wrap gap-3">
        <UnavailableButton reasonId="proof-reason">Request provider proof</UnavailableButton>
        <UnavailableButton reasonId="proof-reason">Approve proof</UnavailableButton>
      </div>
      <UnavailableReason id="proof-reason">
        No mail provider is connected, and a safe way to get a provider proof without placing an order has not been confirmed. Until it is, paper mail stays blocked.
      </UnavailableReason>
    </section>

    <section aria-labelledby="send-heading" class="flex flex-col gap-4">
      <h2 id="send-heading" class="text-lg font-semibold">Send</h2>
      <p class="text-muted-foreground max-w-prose text-sm text-pretty">
        Proposed: once sending exists, "accepted" would mean the request was recorded and passed on, not that it was delivered. A request that times out would show as an unknown outcome, and nothing would be resent automatically.
      </p>
      <div class="flex flex-wrap gap-3">
        <UnavailableButton reasonId="send-reason">Send</UnavailableButton>
      </div>
      <UnavailableReason id="send-reason">
        Sending is turned off. There is no backend, no provider connection and no sign-in yet, and the fax and mail features are proposed to be off by default.
        <a href="/settings/" class="underline underline-offset-4">See settings</a>.
      </UnavailableReason>
    </section>
  </div>
</AppLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#draft-form');
  const status = document.querySelector<HTMLElement>('#draft-status');
  const fieldset = document.querySelector<HTMLFieldSetElement>('#draft-fields');
  if (form && status && fieldset) {
    const fields = ['recipient', 'address', 'body'] as const;
    const url = new URL(location.href);
    let id = url.searchParams.get('draft');
    let revision = 0;
    let ready = !id;
    fieldset.disabled = !ready;
    const message = (text: string) => { status.textContent = text; };
    const control = (field: string) => form.elements.namedItem(field) as HTMLInputElement | HTMLTextAreaElement;
    if (id) {
      message('Loading draft…');
      fetch(`/api/mail-drafts/${encodeURIComponent(id)}`, { cache: 'no-store' })
        .then(async response => {
          if (!response.ok) throw new Error('load');
          const draft = await response.json();
          for (const field of fields) control(field).value = typeof draft.content[field] === 'string' ? draft.content[field] : '';
          revision = draft.revision;
          ready = true;
          fieldset.disabled = false;
          message('Draft loaded.');
        }).catch(() => message('Draft could not be loaded. Storage may be unavailable, or this draft may not exist. Your changes cannot be saved until it loads.'));
    }
    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (!ready) return;
      ready = false;
      id ??= crypto.randomUUID();
      const content = Object.fromEntries(fields.map(field => [field, control(field).value]));
      message('Saving…');
      try {
        const response = await fetch(`/api/mail-drafts/${id}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ revision, content }) });
        if (response.status === 409) { url.searchParams.set('draft', id); history.replaceState(null, '', url); message('This draft changed elsewhere or the previous save may have succeeded. Copy your edits, then reload to review the saved version.'); return; }
        if (response.status >= 500) throw new Error('unknown outcome');
        if (!response.ok) { message('Draft was not saved. Check your session and try again; your text remains here.'); ready = true; return; }
        const saved = await response.json();
        revision = saved.revision;
        url.searchParams.set('draft', id);
        history.replaceState(null, '', url);
        message('Draft saved. Bookmark or copy this page URL to return to it.');
        ready = true;
      } catch {
        url.searchParams.set('draft', id);
        history.replaceState(null, '', url);
        message('Save outcome is unknown. Copy your edits, then reload this link to check the saved version before retrying.');
      }
    });
  }
</script>
