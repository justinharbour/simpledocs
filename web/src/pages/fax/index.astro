---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
---
<AppLayout title="Send a fax" description="Send a PDF and check its delivery status.">
  <PageHeader title="Send a fax" summary="Choose a PDF and enter the destination number." />
  <p class="text-muted-foreground text-sm">Fax availability depends on the instance configuration. Provider acceptance does not confirm delivery.</p>
  <form id="fax-form" class="mt-10 flex max-w-xl flex-col gap-5">
    <label class="flex flex-col gap-2" for="destination">Fax number <span class="text-muted-foreground text-sm">Include the country code, for example +12025550102.</span></label>
    <input class="rounded-md border border-input bg-background px-3 py-2" id="destination" name="destination" type="tel" required pattern="\+[1-9][0-9]{1,14}" />
    <label class="flex flex-col gap-2" for="document">PDF document <span class="text-muted-foreground text-sm">Maximum 5 MB.</span></label>
    <input id="document" name="document" type="file" accept="application/pdf,.pdf" required />
    <label class="flex items-start gap-2"><input class="mt-1" type="checkbox" name="confirmed" value="true" required /> I confirm this is an authorized recipient and agree to the fax charges.</label>
    <button class="self-start rounded-md bg-primary px-4 py-2 text-primary-foreground" type="submit" disabled>Send fax</button>
  </form>
  <p id="fax-status" class="mt-5" role="status" aria-live="polite"></p>
  <button id="fax-check" type="button" hidden class="mt-3 rounded-md border border-input px-4 py-2">Check delivery status</button>
  <section class="mt-16 max-w-3xl border-t border-border pt-8" aria-labelledby="inbox-heading">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <div>
        <h2 id="inbox-heading" class="text-lg font-semibold">Received faxes</h2>
        <p class="mt-1 text-sm text-muted-foreground">The most recent 100 received faxes, available to authorized inbox users.</p>
      </div>
      <button id="inbox-refresh" type="button" class="rounded-md border border-input px-4 py-2">Refresh inbox</button>
    </div>
    <p id="inbox-status" class="mt-5 text-sm" role="status" aria-live="polite">Loading received faxes…</p>
    <ul id="inbox-list" class="mt-4 divide-y divide-border" aria-label="Received faxes"></ul>
    <noscript><p class="mt-4">JavaScript is required to load received faxes.</p></noscript>
  </section>
  <script>
    import { loadInbox } from '@/lib/fax-inbox';
    const list = document.querySelector<HTMLUListElement>('#inbox-list')!;
    const message = document.querySelector<HTMLElement>('#inbox-status')!;
    const refresh = document.querySelector<HTMLButtonElement>('#inbox-refresh')!;
    async function updateInbox() {
      refresh.disabled = true;
      message.textContent = 'Loading received faxes…';
      list.replaceChildren();
      try {
        const { records, pendingCount } = await loadInbox(fetch);
        if (!records.length) message.textContent = 'No received faxes yet.';
        else {
          message.textContent = `${records.length} received ${records.length === 1 ? 'fax' : 'faxes'} shown.`;
          for (const record of records) {
            const item = document.createElement('li');
            item.className = 'flex flex-wrap items-center justify-between gap-3 py-4';
            const date = document.createElement('span');
            date.textContent = `Received ${record.receivedLabel}`;
            const link = document.createElement('a');
            link.className = 'rounded-md border border-input px-4 py-2 text-sm underline underline-offset-4';
            link.href = record.downloadPath;
            link.textContent = 'Download PDF';
            link.setAttribute('aria-label', `Download fax received ${record.receivedLabel} as PDF`);
            item.append(date, link); list.append(item);
          }
        }
        if (pendingCount) message.textContent += ` Attention: ${pendingCount} received ${pendingCount === 1 ? 'fax has' : 'faxes have'} not been archived. Contact the operator to investigate; the PDF may be unavailable.`;
      } catch { message.textContent = 'The inbox could not be loaded. Check your access and try Refresh inbox.'; }
      finally { refresh.disabled = false; }
    }
    refresh.addEventListener('click', updateInbox);
    void updateInbox();
  </script>
  <script>
    import { discoverUnresolved } from '@/lib/fax-recovery';
    const form = document.querySelector<HTMLFormElement>('#fax-form')!;
    const status = document.querySelector<HTMLElement>('#fax-status')!;
    const check = document.querySelector<HTMLButtonElement>('#fax-check')!;
    const send = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    let id = sessionStorage.getItem('simpledocs-last-fax');
    async function discover() {
      send.disabled = true;
      try {
        const intents = await discoverUnresolved(fetch);
        if (intents.length) {
          id = intents[0].id; check.hidden = false;
          status.textContent = `Previous fax status: ${intents[0].status}. Do not send again; check status or contact the operator for reconciliation.`;
        } else { send.disabled = false; if (id) check.hidden = false; }
      } catch { status.textContent = 'Unable to check previous sends. Sending is paused; refresh to try again.'; }
    }
    void discover();
    form.addEventListener('submit', async event => {
      event.preventDefault();
      id = crypto.randomUUID(); sessionStorage.setItem('simpledocs-last-fax', id);
      send.disabled = true; check.hidden = false; status.textContent = 'Sending fax…';
      try {
        const response = await fetch(`/api/faxes/${id}`, { method: 'POST', body: new FormData(form) });
        const result = await response.json();
        if (!response.ok) { status.textContent = `${result.error || 'The outcome is unknown.'} Check status before sending again.`; return; }
        status.textContent = result.status === 'accepted' ? 'Accepted by Telnyx. Delivery is not yet confirmed.' : `Fax status: ${result.status}. Do not send again until the outcome is known.`;
      } catch { status.textContent = 'The outcome is unknown. Check status before sending again.'; }
      finally { await discover(); }
    });
    check.addEventListener('click', async () => {
      if (!id) return;
      check.disabled = true;
      try {
        const response = await fetch(`/api/faxes/${id}`);
        const result = await response.json();
        status.textContent = response.ok ? `Fax status: ${result.status}.` : 'Status is unavailable. Do not send again until the outcome is known.';
      } catch { status.textContent = 'Status is unavailable. Do not send again until the outcome is known.'; }
      check.disabled = false;
      await discover();
    });
  </script>
</AppLayout>
