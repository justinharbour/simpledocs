---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import NotConnectedNotice from "@/components/NotConnectedNotice.astro";
import EmptyState from "@/components/EmptyState.astro";
---

<AppLayout title="Settings" description="Choose which channels are turned on.">
  <PageHeader title="Settings" summary="Choose which channels are turned on." />
  <NotConnectedNotice title="Settings are not available">
    Channels cannot be turned on or off until the backend exists. Nothing on this page can be changed.
  </NotConnectedNotice>
  <section aria-labelledby="list-heading" class="mt-10">
    <h2 id="list-heading" class="mb-3 text-lg font-semibold">Channels</h2>
    <EmptyState title="No channel settings yet">
      Each channel will have its own switch, including inbound fax and inbound voice.
    </EmptyState>
  </section>
</AppLayout>
