---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
---
<AppLayout title="Settings" description="Instance settings.">
  <PageHeader title="Settings" summary="Manage this simpledocs instance." />
  <section class="mt-10 max-w-2xl" aria-labelledby="settings-heading">
    <h2 id="settings-heading" class="text-lg font-semibold">Configuration</h2>
    <p class="mt-3 text-sm text-muted-foreground">Settings cannot currently be changed from this page. The instance operator manages provider and channel configuration.</p>
    <p class="mt-3 text-sm"><a href="/fax/" class="underline underline-offset-4">Open fax</a></p>
  </section>
</AppLayout>
