---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import NotConnectedNotice from "@/components/NotConnectedNotice.astro";
import EmptyState from "@/components/EmptyState.astro";
---

<AppLayout title="Calls" description="Calls and voicemail.">
  <PageHeader title="Calls" summary="Calls and voicemail." />
  <NotConnectedNotice title="Calls are not connected">
    Connect a phone provider and number to make or receive calls. Voicemail needs private recording storage.
  </NotConnectedNotice>
  <section aria-labelledby="list-heading" class="mt-10">
    <h2 id="list-heading" class="mb-3 text-lg font-semibold">Call history and voicemail</h2>
    <EmptyState title="No calls or voicemail yet">
      Call history and voicemail recordings will appear here once calls are connected.
    </EmptyState>
  </section>
</AppLayout>
