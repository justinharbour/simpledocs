---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
---
<AppLayout title="Send mail" description="Review a letter before creating a paid mail order.">
  <PageHeader title="Send mail" summary="Prepare a US letter, review its exact contents, then confirm before sending." />
  <p class="text-muted-foreground text-sm">Mail sending requires an enabled and configured provider. A submitted order may incur charges.</p>
  <p id="mail-message" role="status" aria-live="polite" class="mt-5 whitespace-pre-wrap text-sm"></p>
  <p id="mail-id" class="text-muted-foreground mt-2 break-all text-xs"></p>
  <section id="mail-unresolved" hidden aria-labelledby="unresolved-heading" class="mt-6 max-w-3xl rounded-md border p-4">
    <h2 id="unresolved-heading" class="font-semibold">Orders requiring attention</h2>
    <p class="mt-2 text-sm">Accepted orders must be acknowledged before another send. Unknown or submitting orders require operator reconciliation. Do not create a replacement.</p>
    <ul id="mail-unresolved-list" class="mt-3 space-y-2 break-all text-sm"></ul>
    <button id="mail-refresh-unresolved" type="button" class="mt-4 rounded-md border border-input px-4 py-2">Refresh unresolved orders</button>
  </section>
  <noscript><p>JavaScript is required to prepare and review a letter. No letter will be sent without it.</p></noscript>
  <form id="mail-form" method="post" class="mt-8 max-w-3xl space-y-8">
    <fieldset id="mail-fields" disabled class="space-y-8">
      {['to', 'from'].map((party) => (
        <fieldset class="space-y-4">
          <legend class="mb-3 text-lg font-semibold">{party === 'to' ? 'Recipient' : 'Return address'}</legend>
          <div class="grid gap-4 sm:grid-cols-2">
            {[
              ['firstName', 'First name', true], ['lastName', 'Last name', false],
              ['addressLine1', 'Street address', true], ['addressLine2', 'Apartment or suite', false],
              ['city', 'City', true], ['provinceOrState', 'State', true], ['postalOrZip', 'ZIP code', true],
            ].map(([name, label, required]) => (
              <label class="flex flex-col gap-1.5 text-sm font-medium">{label}
                <input name={`${party}.${name}`} required={required} maxlength="150" class="rounded-md border border-input bg-background px-3 py-2 font-normal" />
              </label>
            ))}
          </div>
          <p class="text-muted-foreground text-sm">Country: United States</p>
        </fieldset>
      ))}
      <label class="flex flex-col gap-1.5 text-sm font-medium" for="letter-text">Letter text <span class="text-muted-foreground font-normal">Braces and ampersands are not supported because they may be interpreted as provider template syntax.</span>
        <textarea id="letter-text" name="text" required maxlength="40000" rows="12" class="rounded-md border border-input bg-background px-3 py-2 font-normal"></textarea>
      </label>
      <fieldset class="space-y-3">
        <legend class="mb-3 text-lg font-semibold">Print and mailing options</legend>
        <label class="flex flex-col gap-1.5 text-sm font-medium" for="mail-class">Mailing class
          <select id="mail-class" name="mailingClass" class="rounded-md border border-input bg-background px-3 py-2 font-normal"><option value="first_class">First class</option><option value="standard_class">Standard class</option></select>
        </label>
        <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="color" /> Print in color</label>
        <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="doubleSided" /> Print double-sided</label>
        <p class="text-muted-foreground text-sm">US Letter, standard paper and envelope. A blank address page is inserted.</p>
      </fieldset>
      <button id="mail-review-button" class="rounded-md bg-primary px-4 py-2 text-primary-foreground disabled:opacity-50" type="submit">Save and review letter</button>
    </fieldset>
  </form>
  <section id="mail-review" hidden aria-labelledby="review-heading" class="mt-10 max-w-3xl space-y-5 border-t pt-7">
    <h2 id="review-heading" tabindex="-1" class="text-xl font-semibold">Review before sending</h2>
    <p class="text-sm">This programmatic preview shows the exact information that will be submitted. It is <strong>not rendered by PostGrid</strong>; the printed letter, layout, pagination and address handling may differ. An inserted address page can affect cost. Check the full request below.</p>
    <h3 class="font-semibold">Letter text</h3>
    <pre id="mail-preview" class="max-h-80 overflow-auto whitespace-pre-wrap break-words rounded-md border bg-card p-4 font-sans text-sm"></pre>
    <h3 class="font-semibold">Exact PostGrid request</h3>
    <pre id="mail-payload" class="max-h-96 overflow-auto whitespace-pre-wrap break-all rounded-md border bg-card p-4 text-xs"></pre>
    <label class="flex items-start gap-2 text-sm"><input id="mail-confirm" type="checkbox" class="mt-1" /> <span>I reviewed the recipient, return address, text and print options above. I authorize this paid mail order.</span></label>
    <div class="flex flex-wrap gap-3"><button id="mail-send" type="button" disabled class="rounded-md bg-primary px-4 py-2 text-primary-foreground disabled:opacity-50">Confirm and send letter</button><button id="mail-edit" type="button" class="rounded-md border border-input px-4 py-2">Edit letter</button></div>
  </section>
  <button id="mail-check" type="button" hidden class="mt-5 rounded-md border border-input px-4 py-2">Check order status</button>
  <button id="mail-new" type="button" hidden class="mt-5 rounded-md border border-input px-4 py-2">Start a different letter</button>
  <script src="../../lib/mail-ui.ts"></script>
</AppLayout>
