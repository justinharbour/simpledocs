---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import NotConnectedNotice from "@/components/NotConnectedNotice.astro";
import EmptyState from "@/components/EmptyState.astro";
---

<AppLayout title="Mail" description="Physical mail with a provider proof you approve before anything is sent.">
  <PageHeader title="Mail" summary="Physical mail with a provider proof you approve before anything is sent." />
  <NotConnectedNotice title="Mail is not connected">
    Connect a mail provider to send. Every letter will need a provider-generated proof and your approval first. Tracking and return receipts depend on the destination.
  </NotConnectedNotice>
  <section aria-labelledby="list-heading" class="mt-10">
    <h2 id="list-heading" class="mb-3 text-lg font-semibold">Mail</h2>
    <EmptyState title="No mail yet">
      Letters will be listed here with their proof, approval and tracking when available.
    </EmptyState>
  </section>
</AppLayout>
