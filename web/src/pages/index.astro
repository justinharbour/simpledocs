---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import SendIcon from "@tabler/icons/outline/send.svg";
import PhoneIcon from "@tabler/icons/outline/phone.svg";
import FilesIcon from "@tabler/icons/outline/files.svg";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/starwind/card";

const links = [
  { href: "/send/", title: "Send", icon: SendIcon, text: "Pick a PDF once and send it by fax, paper mail, or both." },
  { href: "/calls/", title: "Calls", icon: PhoneIcon, text: "Make a call, read the call log and play voicemail." },
  { href: "/records/", title: "Records", icon: FilesIcon, text: "See what was sent and received, and where each one stands." },
];
---

<AppLayout title="Overview" description="Your communications workspace.">
  <PageHeader title="Overview" summary="Send documents, take calls and keep the record in one place." />
  <ul class="grid max-w-4xl gap-4 sm:grid-cols-3">
    {
      links.map(({ href, title, icon: Icon, text }) => (
        <li>
          <a href={href} class="focus-visible:ring-outline/50 block h-full rounded-xl outline-none focus-visible:ring-3">
            <Card class="hover:bg-muted/50 h-full">
              <CardHeader>
                <CardTitle class="flex items-center gap-2">
                  <Icon class="size-5" aria-hidden="true" />
                  {title}
                </CardTitle>
                <CardDescription>{text}</CardDescription>
              </CardHeader>
            </Card>
          </a>
        </li>
      ))
    }
  </ul>
</AppLayout>
