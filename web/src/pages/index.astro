---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
---
<AppLayout title="Overview" description="Your communications workspace.">
  <PageHeader title="Overview" summary="Send a fax or prepare a paper mail draft." />
  <section class="mt-10 max-w-2xl" aria-labelledby="channels-heading">
    <h2 id="channels-heading" class="mb-3 text-lg font-semibold">Channels</h2>
    <ul class="divide-y divide-border border-y border-border">
      <li class="flex flex-wrap items-baseline justify-between gap-2 py-4"><a href="/fax/" class="font-medium underline underline-offset-4">Send a fax</a><span class="text-sm text-muted-foreground">Submit a PDF and check its status</span></li>
      <li class="flex flex-wrap items-baseline justify-between gap-2 py-4"><a href="/compose/" class="font-medium underline underline-offset-4">Paper mail draft</a><span class="text-sm text-muted-foreground">Save a draft; sending is not available here</span></li>
      <li class="flex flex-wrap items-baseline justify-between gap-2 py-4"><a href="/calls/" class="font-medium underline underline-offset-4">Calls and voicemail</a><span class="text-sm text-muted-foreground">Not yet available</span></li>
    </ul>
  </section>
</AppLayout>
