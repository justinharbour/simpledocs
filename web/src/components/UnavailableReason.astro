---
import LockIcon from "@tabler/icons/outline/lock.svg";

type Props = { id: string };
const { id } = Astro.props;
---

<p id={id} class="text-muted-foreground flex max-w-prose items-start gap-2 text-sm text-pretty">
  <LockIcon class="mt-0.5 size-4 shrink-0" aria-hidden="true" />
  <span><span class="font-medium">Not available.</span> <slot /></span>
</p>
