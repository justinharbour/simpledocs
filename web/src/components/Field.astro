---
import { Label } from "@/components/starwind/label";
import SyntheticLabel from "@/components/SyntheticLabel.astro";

type Props = { id: string; label: string; hint?: string; synthetic?: boolean };
const { id, label, hint, synthetic = false } = Astro.props;
---

<div class="flex flex-col gap-1.5">
  <div class="flex flex-wrap items-center gap-2">
    <Label for={id}>{label}</Label>
    {synthetic && <SyntheticLabel />}
  </div>
  <slot />
  {hint && <p id={`${id}-hint`} class="text-muted-foreground text-sm text-pretty">{hint}</p>}
</div>
