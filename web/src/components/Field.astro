---
import { Label } from "@/components/starwind/label";

type Props = { id: string; label: string; hint?: string };
const { id, label, hint } = Astro.props;
---

<div class="flex flex-col gap-1.5">
  <Label for={id}>{label}</Label>
  <slot />
  {hint && <p id={`${id}-hint`} class="text-muted-foreground text-sm text-pretty">{hint}</p>}
</div>
