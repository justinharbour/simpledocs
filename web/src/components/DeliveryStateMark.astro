---
import PencilIcon from "@tabler/icons/outline/pencil.svg";
import FileSearchIcon from "@tabler/icons/outline/file-search.svg";
import HourglassIcon from "@tabler/icons/outline/hourglass.svg";
import FileCheckIcon from "@tabler/icons/outline/file-check.svg";
import ClockIcon from "@tabler/icons/outline/clock.svg";
import SendIcon from "@tabler/icons/outline/send.svg";
import ProgressIcon from "@tabler/icons/outline/progress.svg";
import CircleCheckIcon from "@tabler/icons/outline/circle-check.svg";
import CircleXIcon from "@tabler/icons/outline/circle-x.svg";
import BanIcon from "@tabler/icons/outline/ban.svg";
import HelpCircleIcon from "@tabler/icons/outline/help-circle.svg";
import { deliveryStateLabels, type DeliveryState } from "@/lib/delivery";

type Props = { state: DeliveryState };
const { state } = Astro.props;

const icons: Record<DeliveryState, typeof PencilIcon> = {
  draft: PencilIcon,
  awaiting_proof: FileSearchIcon,
  awaiting_approval: HourglassIcon,
  ready: FileCheckIcon,
  queued: ClockIcon,
  submitting: SendIcon,
  submitted: SendIcon,
  in_progress: ProgressIcon,
  delivered: CircleCheckIcon,
  failed: CircleXIcon,
  cancelled: BanIcon,
  unknown: HelpCircleIcon,
};
const Icon = icons[state];
---

<span
  class:list={[
    "inline-flex items-center gap-2 whitespace-nowrap",
    state === "failed" ? "text-error font-medium" : "text-foreground",
  ]}
>
  <Icon class="size-4 shrink-0" aria-hidden="true" />
  <span>{deliveryStateLabels[state]}</span>
</span>
