---
import InfoIcon from "@tabler/icons/outline/info-circle.svg";
import { Alert, AlertDescription, AlertTitle } from "@/components/starwind/alert";

type Props = { title?: string };
const { title = "Nothing is connected yet" } = Astro.props;
---

<Alert>
  <AlertTitle class="text-base"><InfoIcon class="size-4" aria-hidden="true" />{title}</AlertTitle>
  <AlertDescription class="text-muted-foreground text-sm"><slot /></AlertDescription>
</Alert>
